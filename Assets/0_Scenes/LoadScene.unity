  - "\uC790\uC2E0\uC758 \uD328\uB97C \uC798 \uC0B4\uD3B4\uBCF4\uACE0 \uAC00\uC7A5
    \uD6A8\uC728\uC801\uC778 \uC870\uD569\uC744 \uB9CC\uB4E4\uC5B4 \uBCF4\uC138\uC694!"
  - "\uB192\uC740 \uC810\uC218\uB97C \uC5BB\uAE30 \uC704\uD574\uC11C\uB294 \uCE74\uB4DC\uC758
    \uC870\uD569\uC774 \uC911\uC694\uD569\uB2C8\uB2E4."
  - "\uCE74\uB4DC\uB97C \uBB34\uC791\uC815 \uBAA8\uC73C\uAE30\uBCF4\uB2E4\uB294 \uC644\uC131\uD560
    \uC870\uD569\uC744 \uBA3C\uC800 \uC0DD\uAC01\uD574 \uBCF4\uC138\uC694."
  - "\uC0C1\uB300\uBC29\uBCF4\uB2E4 \uBA3C\uC800 \uC870\uD569\uC744 \uC644\uC131\uD558\uB294
    \uAC83\uC774 \uC2B9\uB9AC\uC758 \uC5F4\uC1E0\uC785\uB2C8\uB2E4."
  - "\uCE74\uB4DC\uB97C \uBC84\uB9AC\uAE30 \uC804\uC5D0\uB294 \uC790\uC2E0\uC758
    \uB2E4\uC74C \uD134\uC744 \uACE0\uB824\uD574 \uBCF4\uC138\uC694."
  - "\uBAA8\uB4E0 \uCE74\uB4DC\uB294 \uC870\uD569\uC758 \uC911\uC694\uD55C \uC7AC\uB8CC\uAC00
    \uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD604\uC7AC \uD328\uC758 \uC0C1\uD0DC\uB97C \uD655\uC778\uD558\uACE0 \uB2E4\uC74C
    \uD589\uB3D9\uC744 \uACC4\uD68D\uD574 \uBCF4\uC138\uC694."
  - "\uC870\uD569\uC744 \uC644\uC131\uD558\uB294 \uBC29\uBC95\uC740 \uD55C \uAC00\uC9C0\uAC00
    \uC544\uB2D9\uB2C8\uB2E4."
  - "\uC0C1\uD669\uC5D0 \uB530\uB77C \uBAA9\uD45C \uC870\uD569\uC744 \uBCC0\uACBD\uD558\uB294
    \uAC83\uB3C4 \uC88B\uC740 \uC804\uB7B5\uC785\uB2C8\uB2E4."
  - "\uCE74\uB4DC\uC758 \uC22B\uC790\uC640 \uC0C9\uC0C1\uC744 \uC798 \uD65C\uC6A9\uD574
    \uBCF4\uC138\uC694."
  - "\uC644\uC131\uD560 \uC218 \uC788\uB294 \uC870\uD569\uC744 \uBBF8\uB9AC \uC0DD\uAC01\uD558\uBA74
    \uB354\uC6B1 \uC720\uB9AC\uD569\uB2C8\uB2E4."
  - "\uAC19\uC740 \uC22B\uC790\uC758 \uCE74\uB4DC\uB97C \uBAA8\uC73C\uBA74 \uC0C8\uB85C\uC6B4
    \uC870\uD569\uC744 \uB178\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC5F0\uC18D\uB41C \uC22B\uC790\uB97C \uD65C\uC6A9\uD558\uBA74 \uC870\uD569
    \uC644\uC131\uC758 \uAE30\uD68C\uAC00 \uB298\uC5B4\uB0A9\uB2C8\uB2E4."
  - "\uAC19\uC740 \uC0C9\uC0C1\uC758 \uCE74\uB4DC\uB97C \uBAA8\uC73C\uB294 \uAC83\uB3C4
    \uC88B\uC740 \uC804\uB7B5\uC785\uB2C8\uB2E4."
  - "\uC5EC\uB7EC \uC870\uD569\uC758 \uAC00\uB2A5\uC131\uC744 \uC5F4\uC5B4\uB450\uBA74
    \uC0C1\uD669\uC5D0 \uC720\uC5F0\uD558\uAC8C \uB300\uC751\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC644\uC131\uC5D0 \uAC00\uAE4C\uC6B4 \uC870\uD569\uC744 \uC6B0\uC120\uC801\uC73C\uB85C
    \uAD00\uB9AC\uD574 \uBCF4\uC138\uC694."
  - "\uD55C \uC7A5\uC758 \uCE74\uB4DC\uAC00 \uC804\uCCB4 \uC870\uD569\uC744 \uBC14\uAFC0
    \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD544\uC694 \uC5C6\uB294 \uCE74\uB4DC\uB77C\uACE0 \uC0DD\uAC01\uD55C \uCE74\uB4DC\uAC00
    \uB098\uC911\uC5D0\uB294 \uD575\uC2EC \uCE74\uB4DC\uAC00 \uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD604\uC7AC \uD328\uBFD0\uB9CC \uC544\uB2C8\uB77C \uC55E\uC73C\uB85C \uD544\uC694\uD55C
    \uCE74\uB4DC\uB3C4 \uC0DD\uAC01\uD574 \uBCF4\uC138\uC694."
  - "\uC870\uD569\uC744 \uC644\uC131\uD558\uB294 \uB370 \uD544\uC694\uD55C \uCE74\uB4DC\uAC00
    \uBB34\uC5C7\uC778\uC9C0 \uD30C\uC545\uD574 \uBCF4\uC138\uC694."
  - "\uBB34\uB9AC\uD558\uAC8C \uB192\uC740 \uC810\uC218\uB9CC \uB178\uB9AC\uB2E4
    \uAE30\uD68C\uB97C \uB193\uCE58\uC9C0 \uB9C8\uC138\uC694."
  - "\uC644\uC131 \uAC00\uB2A5\uD55C \uC870\uD569\uC774 \uC5EC\uB7EC \uAC1C\uB77C\uBA74
    \uC810\uC218\uB97C \uBE44\uAD50\uD574 \uBCF4\uC138\uC694."
  - "\uC0C1\uD669\uC5D0 \uB530\uB77C \uC548\uC815\uC801\uC778 \uC870\uD569\uACFC
    \uACE0\uB4DD\uC810 \uC870\uD569 \uC911 \uD558\uB098\uB97C \uC120\uD0DD\uD558\uC138\uC694."
  - "\uBC84\uB9BC\uD328\uB97C \uD655\uC778\uD558\uBA74 \uC0C1\uB300\uBC29\uC758 \uC804\uB7B5\uC744
    \uC720\uCD94\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC0C1\uB300\uBC29\uC774 \uC5B4\uB5A4 \uCE74\uB4DC\uB97C \uBAA8\uC73C\uACE0
    \uC788\uB294\uC9C0 \uAD00\uCC30\uD574 \uBCF4\uC138\uC694."
  - "\uC790\uC2E0\uC758 \uD328\uB97C \uACF5\uAC1C\uD558\uC9C0 \uC54A\uB294 \uAC83\uB3C4
    \uC911\uC694\uD55C \uC804\uB7B5\uC785\uB2C8\uB2E4."
  - "\uC0C1\uB300\uBC29\uC758 \uD589\uB3D9\uC744 \uD1B5\uD574 \uD544\uC694\uD55C
    \uCE74\uB4DC\uAC00 \uBB34\uC5C7\uC778\uC9C0 \uCD94\uCE21\uD574 \uBCF4\uC138\uC694."
  - "\uB9C8\uC9C0\uB9C9 \uD55C \uC7A5\uC744 \uAE30\uB2E4\uB9AC\uB294 \uC21C\uAC04\uC5D0\uB3C4
    \uC804\uB7B5\uC740 \uACC4\uC18D\uB429\uB2C8\uB2E4."
  - "\uB54C\uB85C\uB294 \uBE60\uB978 \uC644\uC131\uC774 \uB192\uC740 \uC810\uC218\uBCF4\uB2E4
    \uC720\uB9AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD2B9\uC218 \uCE74\uB4DC\uB294 \uBD88\uB9AC\uD55C \uC0C1\uD669\uC744 \uB4A4\uC9D1\uC744
    \uAE30\uD68C\uAC00 \uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD2B9\uC218 \uCE74\uB4DC\uC758 \uD6A8\uACFC\uB97C \uC798 \uD65C\uC6A9\uD558\uBA74
    \uC804\uB7B5\uC758 \uD3ED\uC774 \uB113\uC5B4\uC9D1\uB2C8\uB2E4."
  - "\uD2B9\uC218 \uCE74\uB4DC\uB294 \uC0AC\uC6A9\uD558\uB294 \uC2DC\uC810\uC774
    \uC911\uC694\uD569\uB2C8\uB2E4."
  - "\uC0C1\uB300\uBC29\uC758 \uD589\uB3D9\uC744 \uBC29\uD574\uD560 \uB54C \uD2B9\uC218
    \uCE74\uB4DC\uB97C \uD65C\uC6A9\uD574 \uBCF4\uC138\uC694."
  - "\uD2B9\uC218 \uCE74\uB4DC\uB97C \uC544\uAEF4\uB450\uB294 \uAC83\uC774 \uB354
    \uC88B\uC740 \uC120\uD0DD\uC77C \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC0C1\uD669\uC5D0 \uB530\uB77C \uD2B9\uC218 \uCE74\uB4DC\uC758 \uD65C\uC6A9
    \uAC00\uCE58\uB294 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4."
  - "\uD2B9\uC218 \uCE74\uB4DC \uD55C \uC7A5\uC73C\uB85C \uC2B9\uBD80\uC758 \uD750\uB984\uC774
    \uBC14\uB014 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC0C1\uB300\uBC29\uC774 \uC870\uD569\uC744 \uC644\uC131\uD558\uAE30 \uC804\uC5D0
    \uACAC\uC81C\uD560 \uAE30\uD68C\uB97C \uC0B4\uD3B4\uBCF4\uC138\uC694."
  - "\uD2B9\uC218 \uCE74\uB4DC\uC758 \uD6A8\uACFC\uB97C \uC219\uC9C0\uD558\uBA74
    \uB354\uC6B1 \uC720\uB9AC\uD558\uAC8C \uD50C\uB808\uC774\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD2B9\uC218 \uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD558\uAE30 \uC804\uC5D0\uB294
    \uC774\uD6C4\uC758 \uC0C1\uD669\uB3C4 \uACE0\uB824\uD574 \uBCF4\uC138\uC694."
  - "\uC0C1\uB300\uBC29\uC758 \uBC84\uB9BC\uD328\uC5D0\uB294 \uC804\uB7B5\uC758 \uD754\uC801\uC774
    \uB0A8\uC544 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC0C1\uB300\uBC29\uC774 \uBC84\uB9B0 \uCE74\uB4DC\uB3C4 \uC911\uC694\uD55C
    \uC815\uBCF4\uAC00 \uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC0C1\uB300\uBC29\uC774 \uC6D0\uD558\uB294 \uCE74\uB4DC\uB97C \uCD94\uCE21\uD574
    \uBCF4\uC138\uC694."
  - "\uB54C\uB85C\uB294 \uC0C1\uB300\uBC29\uC758 \uC120\uD0DD\uC744 \uC5ED\uC73C\uB85C
    \uC774\uC6A9\uD560 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC0C1\uB300\uBC29\uC758 \uC870\uD569 \uC644\uC131 \uC18D\uB3C4\uB97C \uC8FC\uC758
    \uAE4A\uAC8C \uC0B4\uD3B4\uBCF4\uC138\uC694."
  - "\uBAA8\uB4E0 \uD50C\uB808\uC774\uC5B4\uAC00 \uAC19\uC740 \uBAA9\uD45C\uB97C
    \uAC00\uC9C0\uACE0 \uC788\uB294 \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4."
  - "\uC790\uC2E0\uC758 \uC804\uB7B5\uC744 \uC27D\uAC8C \uB4DC\uB7EC\uB0B4\uC9C0
    \uB9C8\uC138\uC694."
  - "\uC0C1\uB300\uBC29\uC758 \uD589\uB3D9 \uD558\uB098\uD558\uB098\uC5D0 \uC8FC\uC758\uB97C
    \uAE30\uC6B8\uC5EC \uBCF4\uC138\uC694."
  - "\uC0C1\uB300\uBC29\uC774 \uBC84\uB9B0 \uCE74\uB4DC\uAC00 \uB098\uC5D0\uAC8C\uB294
    \uAE30\uD68C\uAC00 \uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uAC00\uC7A5 \uC704\uD611\uC801\uC778 \uC0C1\uB300\uAC00 \uB204\uAD6C\uC778\uC9C0
    \uD30C\uC545\uD558\uB294 \uAC83\uB3C4 \uC911\uC694\uD569\uB2C8\uB2E4."
  - "\uC0C1\uB300\uBC29\uC758 \uC120\uD0DD\uC744 \uC608\uCE21\uD558\uB294 \uAC83\uC774
    \uC2B9\uB9AC\uC758 \uC9C0\uB984\uAE38\uC785\uB2C8\uB2E4."
  - "\uB54C\uB85C\uB294 \uAE30\uB2E4\uB9AC\uB294 \uAC83\uC774 \uAC00\uC7A5 \uC88B\uC740
    \uC804\uB7B5\uC785\uB2C8\uB2E4."
  - "\uC2B9\uB9AC\uB97C \uD655\uC2E0\uD558\uB294 \uC21C\uAC04\uC5D0\uB3C4 \uBC29\uC2EC\uD558\uC9C0
    \uB9C8\uC138\uC694."
  - "\uB2E4\uB978 \uD50C\uB808\uC774\uC5B4\uC758 \uD328\uAC00 \uC5B4\uB5BB\uAC8C
    \uAD6C\uC131\uB418\uC5B4 \uC788\uC744\uC9C0 \uC0C1\uC0C1\uD574 \uBCF4\uC138\uC694."
  - "\uC0C1\uB300\uBC29\uC758 \uC804\uB7B5\uC744 \uC77D\uC5C8\uB2E4\uBA74 \uD55C\uBC1C
    \uC55E\uC11C \uC6C0\uC9C1\uC5EC \uBCF4\uC138\uC694."
  - "\uB192\uC740 \uC810\uC218\uC758 \uC870\uD569\uC744 \uC644\uC131\uD558\uBA74
    \uB354\uC6B1 \uD070 \uBCF4\uC0C1\uC744 \uC5BB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC870\uD569\uB9C8\uB2E4 \uD68D\uB4DD\uD560 \uC218 \uC788\uB294 \uC810\uC218\uAC00
    \uB2E4\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC810\uC218 \uBC30\uC728\uC744 \uD65C\uC6A9\uD558\uBA74 \uD55C \uBC88\uC5D0
    \uD070 \uC810\uC218\uB97C \uB178\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD604\uC7AC \uC810\uC218\uC640 \uB0A8\uC740 \uBAA9\uD45C \uC810\uC218\uB97C
    \uD655\uC778\uD574 \uBCF4\uC138\uC694."
  - "\uC791\uC740 \uC810\uC218\uB77C\uB3C4 \uAFB8\uC900\uD788 \uC313\uC73C\uBA74
    \uC2B9\uB9AC\uC5D0 \uAC00\uAE4C\uC6CC\uC9D1\uB2C8\uB2E4."
  - "\uACE0\uB4DD\uC810 \uC870\uD569\uC744 \uB178\uB9B4 \uB54C\uB294 \uC2E4\uD328
    \uAC00\uB2A5\uC131\uB3C4 \uACE0\uB824\uD574\uC57C \uD569\uB2C8\uB2E4."
  - "\uC0C1\uB300\uBC29\uACFC\uC758 \uC810\uC218 \uCC28\uC774\uB97C \uD655\uC778\uD558\uACE0
    \uC804\uB7B5\uC744 \uC870\uC815\uD574 \uBCF4\uC138\uC694."
  - "\uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uC5ED\uC804\uC758 \uAE30\uD68C\uB294 \uB0A8\uC544
    \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC2B9\uB9AC\uC5D0 \uD544\uC694\uD55C \uC810\uC218\uB97C \uACC4\uC0B0\uD558\uB294
    \uAC83\uB3C4 \uC804\uB7B5\uC785\uB2C8\uB2E4."
  - "\uC810\uC218\uBFD0\uB9CC \uC544\uB2C8\uB77C \uC870\uD569 \uC644\uC131 \uAC00\uB2A5\uC131\uB3C4
    \uD568\uAED8 \uACE0\uB824\uD558\uC138\uC694."
  - "\uC790\uC2E0\uC758 \uC190\uD328\uB97C \uD655\uC778\uD558\uC5EC \uD604\uC7AC
    \uC870\uD569 \uC0C1\uD0DC\uB97C \uD30C\uC545\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uBC84\uB9BC\uD328 \uC601\uC5ED\uC5D0\uC11C \uC774\uC804\uC5D0 \uC0AC\uC6A9\uB41C
    \uCE74\uB4DC\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uB2E4\uB978 \uD50C\uB808\uC774\uC5B4\uC758 \uBC84\uB9BC\uD328\uB97C \uD655\uC778\uD574
    \uC804\uB7B5\uC744 \uC138\uC6CC \uBCF4\uC138\uC694."
  - "\uD50C\uB808\uC774\uC5B4\uC758 \uD589\uB3D9 \uC21C\uC11C\uB97C \uD655\uC778\uD558\uACE0
    \uB2E4\uC74C \uCC28\uB840\uB97C \uC900\uBE44\uD558\uC138\uC694."
  - "\uCE74\uB4DC\uC758 \uC815\uBCF4\uB97C \uC790\uC138\uD788 \uD655\uC778\uD558\uBA74
    \uC870\uD569\uC744 \uD310\uB2E8\uD558\uAE30 \uC27D\uC2B5\uB2C8\uB2E4."
  - "\uC790\uC2E0\uC758 \uCC28\uB840\uC5D0 \uAC00\uB2A5\uD55C \uD589\uB3D9\uC744
    \uD655\uC778\uD574 \uBCF4\uC138\uC694."
  - "\uAC8C\uC784 \uC9C4\uD589 \uC0C1\uD669\uC744 \uD655\uC778\uD558\uBA74\uC11C
    \uB2E4\uC74C \uC804\uB7B5\uC744 \uC900\uBE44\uD558\uC138\uC694."
  - "\uC0C1\uB300\uBC29\uC758 \uD589\uB3D9\uC744 \uC8FC\uC758 \uAE4A\uAC8C \uAD00\uCC30\uD574
    \uBCF4\uC138\uC694."
  - "\uCE74\uB4DC\uC758 \uC0C9\uC0C1\uACFC \uC22B\uC790\uB97C \uAD6C\uBD84\uD558\uC5EC
    \uD328\uB97C \uAD00\uB9AC\uD574 \uBCF4\uC138\uC694."
  - "\uAC8C\uC784 \uD654\uBA74\uC758 \uC548\uB0B4 \uC815\uBCF4\uB97C \uD65C\uC6A9\uD558\uBA74
    \uB354\uC6B1 \uD3B8\uB9AC\uD558\uAC8C \uD50C\uB808\uC774\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC624\uB298\uC758 \uD589\uC6B4\uC740 \uB2F9\uC2E0\uC758 \uC190\uC5D0 \uC788\uC744\uC9C0\uB3C4
    \uBAA8\uB985\uB2C8\uB2E4!"
  - "\uC644\uBCBD\uD55C \uC870\uD569\uC744 \uD5A5\uD574 \uD55C \uC7A5\uC529 \uB098\uC544\uAC00
    \uBCF4\uC138\uC694."
  - "\uC6B4\uC740 \uC900\uBE44\uB41C \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C \uBBF8\uC18C
    \uC9D3\uC2B5\uB2C8\uB2E4."
  - "\uB9C8\uC9C0\uB9C9 \uD55C \uC7A5\uC774 \uC2B9\uBD80\uB97C \uACB0\uC815\uD560\uC9C0\uB3C4
    \uBAA8\uB985\uB2C8\uB2E4."
  - "\uC88B\uC740 \uD328\uAC00 \uB4E4\uC5B4\uC624\uAE30\uB97C \uAE30\uB3C4\uD574
    \uBCF4\uC138\uC694!"
  - "\uC0C1\uB300\uBC29\uC774 \uC6C3\uACE0 \uC788\uB2E4\uBA74, \uC544\uC9C1 \uBC29\uC2EC\uD558\uC9C0
    \uB9C8\uC138\uC694."
  - "\uB54C\uB85C\uB294 \uC6B4\uBCF4\uB2E4 \uD310\uB2E8\uB825\uC774 \uC911\uC694\uD569\uB2C8\uB2E4."
  - "\uC2B9\uB9AC\uC758 \uC5EC\uC2E0\uC740 \uB204\uAD6C\uC5D0\uAC8C \uBBF8\uC18C
    \uC9C0\uC744\uAE4C\uC694?"
  - "\uD328\uAC00 \uC88B\uC9C0 \uC54A\uB2E4\uACE0 \uC2E4\uB9DD\uD558\uC9C0 \uB9C8\uC138\uC694.
    \uC5ED\uC804\uC740 \uC5B8\uC81C\uB4E0 \uAC00\uB2A5\uD569\uB2C8\uB2E4!"
  - "\uC624\uB298\uB3C4 \uC644\uBCBD\uD55C \uC77C\uACF1 \uC7A5\uC744 \uB9CC\uB4E4\uC5B4
    \uBCF4\uC138\uC694."
  - "\uCE74\uB4DC \uD55C \uC7A5\uC5D0 \uB2F4\uAE34 \uBB34\uD55C\uD55C \uAC00\uB2A5\uC131\uC744

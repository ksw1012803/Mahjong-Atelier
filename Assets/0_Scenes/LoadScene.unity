  nextText: {fileID: 1022371976}
  tipMessages:
  - "\uC138\uBE10\uBA54\uC774\uB4DC\uB294 7\uC7A5\uC758 \uCE74\uB4DC\uB97C \uD65C\uC6A9\uD574
